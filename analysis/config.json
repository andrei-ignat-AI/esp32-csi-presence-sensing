{
  "data_dir": "data",
  "raw_data_subdir": "raw_data",
  "models_storage_base_dir": "saved_models",
  "plots_base_dir": "plots",

  "raw_data_categories": {
    "0_persons": {
      "left": "0_pers/left",
      "right": "0_pers/right"
    },
    "1_person": {
      "left": "1_pers/left",
      "right": "1_pers/right"
    }
  },

  "csi_metadata_columns": ["people", "conf", "csi ts", "det ts"],
  "target_label_column": "people", 

  "dead_subcarrier_indices": [1,2,3,4,5,6,33,60,61,62,63,64],

  "experiment_pipelines": {
    "ground_truth_labels": {
      "pipeline_suffix": "gt",
